{
  "dependencies": {
    "@discord-player/extractor": "7.2.0",
    "@snazzah/davey": "0.2.0",
    "bgutils-js": "4.0.3",
    "discord-player": "7.2.0",
    "discord-player-youtubei": "3.1.4",
    "discord.js": "14.28.1",
    "dotenv": "18.0.10",
    "googlevideo": "5.0.1",
    "mongodb": "7.9.1",
    "openai": "7.63.0",
    "pino": "10.4.0",
    "simple-ytdl-core": "1.2.2"
  },
  "description": "CutieBot v3 — Discord bot (music, economy, AI chat, moderation) rebuilt in TypeScript",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "mongodb-memory-server": "11.4.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "dist/src/index.js",
  "name": "cutiebot",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "commands:deploy": "tsx scripts/deploy-commands.ts",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "version": "3.0.0"
}
