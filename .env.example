# CutieBot v3 — environment variables (names only; never commit real values)
#
# Required — the bot refuses to boot without these:
DISCORD_TOKEN=
CLIENT_ID=
MONGO_URI=
#
# Optional:
# Guild to register commands in during development (deploy script --guild defaults to this)
GUILD_ID=
# Discord user ID of the bot owner (gates owner-only admin commands)
OWNER_ID=
# OpenAI — AI chat features degrade gracefully when unset
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional burner-account YouTube cookie (documented mitigation for datacenter-IP bot checks; never a personal account)
YOUTUBE_COOKIE=
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=
# AI daily usage caps (Phase 6): non-negative integers; 0 refuses all AI use.
# Defaults when unset: 50 per user per day, 500 across all users per day.
AI_PER_USER_DAILY_CAP=
AI_GLOBAL_DAILY_CAP=
